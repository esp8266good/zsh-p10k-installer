# 這個映像存在的唯一理由：它的 awk 是 mawk 1.3.3（1996 年版）。
#
# mawk 1.3.3 不支援 POSIX 字元類別，而且是靜默不匹配：[[:space:]] 不會報錯，
# 只是永遠不成立。樹莓派（Raspbian buster）上 ~/.zshrc.local 一直產不出來
# 就是這麼來的，而在 gawk / mawk 1.3.4 的機器上完全複現不出來。
#
# buster 已經 EOL，套件索引搬到 archive.debian.org 而且不再有簽章更新。
FROM debian:buster

RUN printf '%s\n' \
      'deb http://archive.debian.org/debian buster main' \
      'deb http://archive.debian.org/debian-security buster/updates main' \
      > /etc/apt/sources.list \
 && printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99no-check-valid \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      git curl ca-certificates sudo procps passwd less mawk

RUN mkdir -p /opt/seed \
 && git clone --depth=1 -q https://github.com/ohmyzsh/ohmyzsh.git /opt/seed/oh-my-zsh

RUN useradd -m -s /bin/bash tester \
 && echo 'tester ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/tester

USER tester
WORKDIR /home/tester
